PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://root:yourpassword@localhost:3306/reachinbox_scheduler"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Ethereal Email Credentials (optional; test account auto-created if empty)
ETHEREAL_USER=
ETHEREAL_PASS=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Rate Limiting & Delays
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_MAX_HOURLY_LIMIT=200

# Slack Integration (Optional default fallback webhook)
SLACK_WEBHOOK_URL=

# Auth & CORS
JWT_SECRET=reachinbox-scheduler-jwt-secret-xyz
FRONTEND_URL=http://localhost:3000
